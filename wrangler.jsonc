{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "teleturniej",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  // Strona UKRYTA: adres *.workers.dev i adresy podglądowe wyłączone.
  // Żeby ją pokazać, ustaw "workers_dev": true i wypchnij do main.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      { "name": "ROOMS", "class_name": "GameRoom" },
      { "name": "LOGIN_GUARD", "class_name": "LoginGuard" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["LoginGuard"] }
  ],
  "observability": { "enabled": true }
}
